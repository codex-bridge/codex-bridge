TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# The Web workbench can run without Telegram or Slack.
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8787
# WEB_ATTACHMENT_DIR=./workspaces/web-attachments

# Slack is optional. Keep these fields when the unified runtime should accept Slack.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_CHANNEL_IDS=
# OPENAI_API_KEY=
# SLACK_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# SLACK_ATTACHMENT_DIR=./workspaces/slack-attachments
# Socket Mode reconnects automatically. The defaults tolerate transient stalls.
# SLACK_SOCKET_CLIENT_PING_TIMEOUT_MS=15000
# SLACK_SOCKET_SERVER_PING_TIMEOUT_MS=45000
BRIDGE_CALLBACK_SECRET=

# Slack app setting: keep Delayed Events disabled. Runtime handling remains tolerant of delayed/replayed events.

# Bridge connection settings. Codex behavior is read from global and project config.toml files.
# BRIDGE_DB_FILE=./workspaces/bridge.sqlite
# CODEX_TRANSPORT=stdio
# CODEX_APP_SERVER_CMD=codex
# To avoid PATH differences under PM2, pin the binary, for example:
# CODEX_APP_SERVER_CMD=/opt/homebrew/bin/codex
# CODEX_APP_SERVER_ARGS=["app-server"]
# CODEX_APP_SERVER_WS_URL=
# CODEX_SERVICE_NAME=codex-bridge
# CODEX_AUTO_COMPACT_ON_INCOMPATIBLE_HISTORY=false
