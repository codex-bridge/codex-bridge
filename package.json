{
  "name": "codex-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && yarn web:build",
    "web:build": "vite build --config web/vite.config.ts",
    "web:watch": "vite build --watch --config web/vite.config.ts",
    "check:language": "node scripts/check-source-language.mjs",
    "web-dev:start": "./scripts/web-dev-tmux.sh start",
    "web-dev:attach": "./scripts/web-dev-tmux.sh attach",
    "web-dev:status": "./scripts/web-dev-tmux.sh status",
    "web-dev:stop": "./scripts/web-dev-tmux.sh stop",
    "web-dev:tls": "node scripts/web-dev-tls.mjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.verify-codex.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint src tests web scripts/verify-codex.ts scripts/verify-codex",
    "lint:fix": "eslint src --fix",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx src/db-cli.ts migrate",
    "db:check": "node --import tsx src/db-cli.ts check",
    "db:backup": "node --import tsx src/db-cli.ts backup",
    "db:reset-state": "node --import tsx src/db-cli.ts reset-state",
    "db:dedupe-slack-sessions": "node --import tsx src/db-cli.ts dedupe-slack-sessions",
    "dev": "node --import tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "native:rebuild": "node scripts/rebuild-better-sqlite3.cjs",
    "probe:protocol": "tsx scripts/probes/probe-method-diff.ts",
    "check:protocol-evidence": "node --import tsx scripts/probes/check-protocol-evidence.ts",
    "protocol:evidence:refresh": "node --import tsx scripts/probes/refresh-protocol-evidence.ts",
    "probe:timeline": "tsx scripts/probes/probe-thread-timeline.ts",
    "verify:codex": "node --import tsx scripts/verify-codex.ts",
    "verify:session-refresh": "node --import tsx scripts/verify-codex.ts --scenario session-refresh",
    "pm2:start": "pm2 start ecosystem.config.cjs --only codex-bridge --update-env",
    "pm2:stop": "pm2 stop codex-bridge",
    "pm2:restart": "pm2 startOrRestart ecosystem.config.cjs --only codex-bridge --update-env",
    "pm2:delete": "pm2 delete codex-bridge",
    "pm2:logs": "pm2 logs codex-bridge",
    "pm2:status": "pm2 status codex-bridge",
    "pm2:save": "pm2 save"
  },
  "volta": {
    "node": "22.22.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@slack/bolt": "^5.0.0",
    "@tanstack/react-query": "^5.104.0",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "grammy": "^1.45.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.2"
  },
  "packageManager": "yarn@4.8.1"
}
